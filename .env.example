# Basic
NODE_ENV=development
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/db
IP_ADDRESS=0.0.0.0
PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# Firebase Cloud Messaging (Push Notifications)
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key" to download the JSON file
# 3. Base64 encode the content of that JSON file:
#    Windows (PowerShell): [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("path/to/key.json"))
#    Mac/Linux: base64 -i path/to/key.json
# 4. Paste the resulting string here:
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=your_base64_encoded_service_account_json
